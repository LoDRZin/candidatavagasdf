# ConectaVagasDF — chaves para a assistência por IA
#
# O navegador nunca recebe estas chaves. Para desenvolvimento local com
# Cloudflare/Vite, copie as mesmas variáveis para .dev.vars.

# Gemini é o provedor principal. A API nativa usa x-goog-api-key.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
# Opcional: deixe vazio para usar o endpoint oficial padrão.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# OpenRouter é o fallback. A lista segue os modelos gratuitos configurados
# no Zeno; a aplicação tenta na ordem até obter uma resposta.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,minimax/minimax-m2.7:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,z-ai/glm-5.2:free,liquid/lfm-2.5-2.6b:free,google/gemma-4-31b-it:free
OPENROUTER_SITE_URL=http://127.0.0.1:5173
OPENROUTER_APP_NAME=conectavagasdf

# Já usado pelo painel editorial privado (opcional).
ADMIN_TOKEN=

# Contas e lembretes opcionais. O envio só é habilitado quando todas as
# configurações existem e REMINDER_EMAILS_ENABLED=true.
EMAIL_API_KEY=
EMAIL_FROM=
APP_ORIGIN=
REMINDER_EMAILS_ENABLED=false
