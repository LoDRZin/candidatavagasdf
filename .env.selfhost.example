# Copie para .env.selfhost e substitua os valores. Não publique este arquivo.
# APP_ORIGIN é o endereço HTTPS visto pelo navegador, mesmo com HTTP no loopback.
APP_ORIGIN=https://curriculos.exemplo.com
BIND_HOST=127.0.0.1
PORT=8788
# Configure conforme o cabeçalho que o túnel/proxy SOBRESCREVE com o IP real.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
DB_PATH=/var/lib/conectavagasdf/app.sqlite
ADMIN_GATE_USER=editor
ADMIN_GATE_PASSWORD=substitua-por-uma-senha-unica-de-mais-de-20-caracteres
ADMIN_TOKEN=substitua-por-um-token-aleatorio-diferente-de-32-ou-mais-caracteres
AUTH_ENABLED=true
COURSES_ENABLED=true
LOCAL_MAIL_PREVIEW=false
AI_RESUME_STRUCTURE_ENABLED=false
REMINDER_EMAILS_ENABLED=false
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
# GEMINI_RESUME_MODEL=
# OPENROUTER_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EMAIL_API_KEY=  # chave do Resend; necessária quando AUTH_ENABLED=true
# EMAIL_FROM=
