{
  "name": "conectavagasdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:selfhost",
    "build:selfhost": "tsc -b && vite build --config vite.selfhost.config.ts && node scripts/build-selfhost.mjs",
    "start:selfhost": "node --env-file=.env.selfhost dist/selfhost/server.js",
    "migrate:selfhost": "node --env-file=.env.selfhost dist/selfhost/cli.js migrate",
    "check:selfhost": "node --env-file=.env.selfhost dist/selfhost/cli.js check",
    "backup:selfhost": "node --env-file=.env.selfhost dist/selfhost/cli.js backup",
    "preflight:selfhost": "node --env-file=.env.selfhost dist/selfhost/preflight.js",
    "smoke": "node scripts/smoke.mjs",
    "load:local": "node scripts/load-check.mjs",
    "typecheck": "tsc -b --pretty",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:courses": "playwright test --config playwright.courses.config.ts",
    "lint": "oxlint src worker selfhost --type-aware --deny typescript/no-floating-promises --deny-warnings",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "types": "wrangler types --strict-vars=false",
    "seed:generate": "node scripts/seed-courses.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/vitest-plugin": "1.2.3",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "miniflare": "^5.20260911.0-alpha",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.14.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.131.1"
  }
}
